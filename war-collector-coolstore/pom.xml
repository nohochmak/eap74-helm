<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org" 
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org http://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.openshift</groupId>
    <artifactId>eap-war-puller</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>


    <build>

       <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <!-- Note that the RH Maven version is 3.6.1.  Version 3.11.0 needs 3.6.3 min -->
                <version>3.6.1</version> 
                <executions>
                    <execution>
                        <id>copy-war-files</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <!-- First WAR File -->
                                <artifactItem>
                                    <groupId>com.redhat.coolstore</groupId>
                                    <artifactId>monolith</artifactId>
                                    <version>1.0.0-SNAPSHOT</version>
                                    <type>war</type>
                                    <destFileName>coolstore.war</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <!-- This target folder is the S2I default drop-zone -->
                            <outputDirectory>${project.basedir}/deployments</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>internal-nexus</id>
            <!-- <url>http://nexus-laptop:8081/repository/maven-releases/</url> -->
            <!-- Using Service URL for test -->
            <url>http://nexus3.multi-war-helm-mvn.svc.cluster.local:8081/repository/maven-releases/</url> 
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

</project>
