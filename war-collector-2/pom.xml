<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org" xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org http://apache.org">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>eap-nexus-deployer</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <!-- Configure your Nexus repository -->
    <repositories>
        <repository>
            <id>nexus</id>
            <url>nexus3.multi-war-helm-mvn.svc.cluster.local:8081/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Declare all your pre-compiled WARs here -->
        <dependency>
            <groupId>org.jboss.eap.quickstarts</groupId>
            <artifactId>helloworld-html5</artifactId>
            <version>7.4.0.GA</version>
            <type>war</type>
        </dependency>
        <dependency>
            <groupId>org.jboss.eap.quickstarts</groupId>
            <artifactId>helloworld-rs</artifactId>
            <version>7.4.0.GA</version>
            <type>war</type>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Copy the downloaded WARs to the target directory for S2I to pick up -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/deployments</outputDirectory>
                            <includeTypes>war</includeTypes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
